<!--
  9999_0010_usb_rules.xml
  USB removable media seen by the Windows Wazuh agent: device connected,
  device or access blocked, files read and written. Rule IDs 101500-101508.

  Parent rules (stock Wazuh 4.x, 0575-win-base_rules.xml / 0580-win-security_rules.xml):
    60009 = Windows informational event (any channel)       level 0
    60103 = Windows Security audit success                   level 0
    60104 = Windows Security audit failure                   level 5
    60227 = Security 6416 "new external device recognized"   level 8

  Endpoint prerequisites (see windows/ and docs/SETUP.md):
    - Audit "Plug and Play Events" (success)        -> 6416
    - Audit "Removable Storage" (success + failure) -> 4663 / 4656, task 12812
    - Registry HKLM\SYSTEM\CurrentControlSet\Control\Storage\HotPlugSecureOpen = 1
      (without it some Windows builds log nothing for hot-plugged USB drives)
    - Wazuh agent Security query must NOT exclude 4656/4663 (the default one does)
    - Wazuh agent must collect Microsoft-Windows-Partition/Diagnostic -> 1006

  Devices on the Approved USB list are picked up by the two generated rules in
  9999_0012_usb_approved_generated.xml (101516, 101517), which are children of
  101500 and 101501.
-->

<group name="windows,usb,">

  <!-- =========================== CONNECTED =========================== -->

  <!-- Security 6416: USB mass storage or MTP/phone recognized.
       Narrows stock 60227 (fires for every USB device, incl. mice/keyboards) to storage.
       Wazuh holds Windows paths with each backslash doubled, hence \\+ between SWD and WPD. -->
  <rule id="101500" level="5">
    <if_sid>60227</if_sid>
    <field name="win.eventdata.deviceId" type="pcre2">(?i)^(USBSTOR\\|SWD\\+WPD)</field>
    <description>USB storage connected on $(win.system.computer): $(win.eventdata.deviceDescription) [$(win.eventdata.deviceId)]</description>
    <mitre>
      <id>T1052.001</id>
      <id>T1091</id>
    </mitre>
    <group>usb_device_connected,</group>
  </rule>

  <!-- Partition/Diagnostic 1006: fires on disk arrival with vendor, model, serial and capacity.
       BusType 7 = USB. Capacity 0 = removal, so it is excluded.
       The channel is on by default on Windows 10 1703 and later. -->
  <rule id="101501" level="5">
    <if_sid>60009</if_sid>
    <field name="win.system.channel">^Microsoft-Windows-Partition/Diagnostic$</field>
    <field name="win.system.eventID">^1006$</field>
    <field name="win.eventdata.busType">^7$</field>
    <field name="win.eventdata.capacity" negate="yes">^0$</field>
    <description>USB disk attached on $(win.system.computer): $(win.eventdata.manufacturer) $(win.eventdata.model) SN=$(win.eventdata.serialNumber) bytes=$(win.eventdata.capacity)</description>
    <mitre>
      <id>T1052.001</id>
      <id>T1091</id>
    </mitre>
    <group>usb_device_connected,</group>
  </rule>

  <!-- ============================ BLOCKED ============================ -->

  <!-- Security 6423: device install blocked by "Prevent installation of devices" policy. -->
  <rule id="101502" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^6423$</field>
    <description>Device installation BLOCKED by policy on $(win.system.computer): $(win.eventdata.deviceDescription) [$(win.eventdata.deviceId)]</description>
    <mitre>
      <id>T1052.001</id>
    </mitre>
    <group>usb_device_blocked,</group>
  </rule>

  <!-- Security 4656 audit failure, task 12812 (Removable Storage):
       read/write denied by "Removable Storage Access" GPO/Intune policy. -->
  <rule id="101503" level="10">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^4656$</field>
    <field name="win.system.task">^12812$</field>
    <description>Removable storage access DENIED for $(win.eventdata.subjectUserName) via $(win.eventdata.processName): $(win.eventdata.objectName)</description>
    <mitre>
      <id>T1052.001</id>
    </mitre>
    <group>usb_device_blocked,</group>
  </rule>

  <!-- ========================= FILE TRANSFER ========================= -->

  <!-- Security 4663, task 12812: WriteData (%%4417) or AppendData (%%4418) on removable media. -->
  <rule id="101505" level="7">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4663$</field>
    <field name="win.system.task">^12812$</field>
    <field name="win.eventdata.accessList" type="pcre2">%%4417|%%4418</field>
    <description>File written to removable storage by $(win.eventdata.subjectUserName) via $(win.eventdata.processName): $(win.eventdata.objectName)</description>
    <mitre>
      <id>T1052.001</id>
    </mitre>
    <group>usb_file_write,usb_write_any,</group>
  </rule>

  <!-- Same, ReadData (%%4416) only: copy FROM the USB device onto the machine.
       Level 3 keeps it searchable; drop to 0 if indexer volume becomes a problem. -->
  <rule id="101506" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4663$</field>
    <field name="win.system.task">^12812$</field>
    <field name="win.eventdata.accessList" type="pcre2">%%4416</field>
    <description>File read from removable storage by $(win.eventdata.subjectUserName) via $(win.eventdata.processName): $(win.eventdata.objectName)</description>
    <mitre>
      <id>T1091</id>
    </mitre>
    <group>usb_file_read,</group>
  </rule>

  <!-- Correlation: a write to removable media on an agent that had a USB storage device
       connect within the last hour. Same pattern as stock 40112 (if_group + if_matched_group).
       same_location = same agent for EventChannel events.
       Approved devices do not count as "connected" here (see the generated rules). -->
  <rule id="101507" level="10" timeframe="3600">
    <if_group>usb_file_write</if_group>
    <if_matched_group>usb_device_connected</if_matched_group>
    <same_location />
    <description>File transfer to newly connected USB device by $(win.eventdata.subjectUserName) via $(win.eventdata.processName): $(win.eventdata.objectName)</description>
    <mitre>
      <id>T1052.001</id>
    </mitre>
    <group>usb_write_any,usb_transfer_correlated,</group>
  </rule>

  <!-- Bulk copy: about 25 removable-media file writes on one agent within 5 minutes.
       ignore=600 stops it re-firing every event during one long copy. -->
  <rule id="101508" level="12" frequency="25" timeframe="300" ignore="600">
    <if_matched_group>usb_write_any</if_matched_group>
    <same_location />
    <description>Bulk file copy to removable storage on $(win.system.computer) by $(win.eventdata.subjectUserName) - possible data exfiltration</description>
    <mitre>
      <id>T1052.001</id>
    </mitre>
    <group>usb_exfil,</group>
  </rule>

</group>
